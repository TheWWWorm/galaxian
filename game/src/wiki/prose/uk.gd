	"character/1": [
		[1, "", "Лейтенантка космічного флоту терранців Christine Hammond зустрічає Maxwell на [[station/0]], показує йому корабель і здійснює з ним перший пробний політ. Вона просить називати її Christine.", false],
		[5, "", "Вона також працює агенткою: на [[station/2]] вона під прикриттям за наказом адмірала Smith і залучає Maxwell до удару по збройовому конвою восків.", false],
		[8, "", "Вона командує ланкою, що захоплює знерухомлений лінійний крейсер восків.", false],
		[12, "", "Вона з'ясовує, що за бандитами стоїть [[character/2|Vlad Borsikov]], і планує атаку на їхню станцію.", false],
		[13, "", "Після бою вона кидається на Vlad, і він її збиває. Її загибель жене Maxwell за Vlad в останньому розділі.", false],
	],
	"character/2": [
		[2, "", "Vlad Borsikov — командир космічного флоту терранців і, за словами Maxwell, найпаскудніший тип у ньому. Він дає Maxwell першу оплачувану роботу: на час очистити космічний коридор від уламків.", false],
		[7, "", "Він збиває шпигуна Corsair Lockwood після того, як той здався, і наполягає, що наказ був знищити корабель.", false],
		[12, "", "Він і є зрадник: ватажок бандитів, який користувався своїм званням, щоб покривати напади на транспорти, і доручив Lockwood викрасти військові таємниці, які продав воскам.", false],
		[13, "", "Коли Christine Hammond кидається за ним після атаки на його станцію, він збиває її й утікає.", false],
		[14, "", "Флот знаходить його з рештками бандитів, і Maxwell убиває його в двобої.", false],
	],
	"character/3": [
		[3, "", "Bolar Nobloon — метушливий клієнт, якому терміново треба на [[station/1]], щоб урятувати угоду; він добре платить пілотові, готовому провезти його через простір восків.", false],
		[4, "", "Він переживає засідку восків і обіцяє порекомендувати Maxwell.", false],
	],
	"character/4": [
		[4, "", "Воск із цим обличчям окликає Maxwell дорогою на Phoebos і вимагає здатися в ім'я Імперії восків.", false],
		[11, "", "Nartok Brek — голова клану [[race/1]]. Він таємно зв'язується з Maxwell, бо один із його власних командирів змовився з терранським офіцером і бандитами, і просить влаштувати зрадникові засідку в туманності Yarapu. Перш ніж щось сказати, він вимагає від Maxwell слова честі.", false],
		[12, "", "Після засідки він повідомляє Maxwell, що той уже знайомий з терранським зрадником.", false],
	],
	"character/5": [
		[4, "", "John Washington, якого друзі звуть Doc, потребує ескорту для свого корабля до [[station/2]]. Він пропонує 3000 кредитів і погоджується на 4500 за умови, що свідків не буде. Maxwell підозрює постачання зброї для бандитів.", false],
		[5, "", "Його вантаж доходить. Що це було, він лишає при собі.", false],
	],
	"character/6": [
		[6, "", "Пілот із ланки Christine Hammond, який питає по радіо, чи бував цей Maxwell узагалі в бою, не помічаючи, що той усе чує.", false],
		[13, "", "Та сама ланка лишається охороняти станцію бандитів, поки Christine і Maxwell переслідують Vlad.", false],
	],
	"character/7": [
		[6, "", "Brent Snocom — офіцер безпеки космічного флоту. Він відправляє Maxwell за шпигуном [[character/8]] з наказом не допустити, щоб викрадений корабель потрапив до рук ворога.", false],
	],
	"character/8": [
		[6, "", "Corsair Lockwood — шпигун, що втік на одному із секретних кораблів космічного флоту.", false],
		[7, "", "Загнаний у кут в астероїдному полі, він здається, але Vlad Borsikov однаково його збиває.", false],
		[12, "", "Пізніше з'ясовується, що саме Vlad доручив йому викрасти військові таємниці.", false],
	],
	"character/9": [
		[7, "", "Mkkt Bkkt возить вантажі для банди октоподів, відомої перевезенням краденого. Він запевняє, що все на борту цілком законне, і платить Maxwell за те, щоб той довів його кораблі до [[station/4]].", false],
	],
	"character/10": [
		[9, "", "Feknor з народу Grey чув про Maxwell і пропонує йому важку роботу: чотири кораблі до [[station/5]] через територію восків, по 4000 кредитів за кожен корабель, що дійде.", false],
	],
	"character/11": [
		[1, "", "Адмірал Smith із космічного флоту терранців подарував Maxwell корабель після звільнення й доручив лейтенантці Hammond показати, як ним користуватися.", false],
		[10, "", "Він викликає Maxwell, коли атакують нівеліанську станцію. Розмова загострюється, коли Maxwell заводить мову про свої розцінки й про те, скільки могли б заплатити воски.", false],
		[13, "", "Після загибелі Christine він висловлює Maxwell співчуття й повідомляє, де переховуються бандити Vlad.", false],
		[14, "", "Він дозволяє Maxwell самому переслідувати Vlad, пропонує йому місце у флоті й, отримавши відмову, дарує гіперпросторовий двигун.", false],
	],
	"character/12": [
		[11, "", "Botom Krant командує нівеліанською станцією, яку атакують воски. Він просить Maxwell зосередитися на крейсерах і дякує йому, коли атаку відбито.", false],
	],
	"race/0": [
		[1, "", "Люди, що воюють проти [[race/1]] у четвертому тисячолітті. Maxwell — терранець, і більшість клієнтів кампанії служать у космічному флоті терранців. Терранцям належить більше планет і станцій, ніж будь-якому іншому народу.", false],
		[1, "", "Багато кораблів на продаж — терранські розробки: [[ship/0]], [[ship/6]] та її модифікація [[ship/7]], а також канонерка [[ship/4]].", false],
	],
	"race/1": [
		[1, "", "Вороги терранців. Крамниці восків продають лише власний винищувач, [[ship/8]], і тільки вони продають зброю восків. Пілотові, що працює на терранців, на станціях восків доводиться давати хабарі, і навпаки.", false],
	],
	"race/2": [
		[1, "", "Один із народів галактики, що має власні планети й станції.", false],
	],
	"race/3": [
		[1, "", "Один із народів галактики, що має власні планети й станції.", false],
	],
	"race/4": [
		[1, "", "Їхні особливі компоненти використовують у зброї на кшталт [[equipment/23]], а важкий бомбардувальник [[ship/3]] — їхня розробка.", false],
	],
	"race/5": [
		[1, "", "Кораблі Grey славляться надзвичайно важкою бронею. Розвідник [[ship/9]] походить з їхнього флоту й лише нещодавно був пристосований для пілотів-гуманоїдів, а ракету [[equipment/4]] зібрано з компонентів Grey. Feknor з народу Grey наймає Maxwell для небезпечного конвою.", false],
	],
	"race/6": [
		[1, "", "Союзники терранців. Винищувач [[ship/1]] — нівеліанська розробка, а лазер [[equipment/2]] ґрунтується на нівеліанських збройових технологіях. Напад восків на одну з їхніх станцій усерйоз утягує Maxwell у війну.", false],
	],
	"race/7": [
		[1, "", "Один із народів галактики, що має власні планети й станції.", false],
	],
	"race/8": [
		[1, "", "Один із народів галактики, що має власні планети й станції.", false],
	],
	"race/9": [
		[1, "", "Бандити — не народ, а спосіб життя: пірати й контрабандисти, що володіють власними планетами й станціями. Лише їхні крамниці продають [[ship/7]], а [[station/2]] — їхнє найвідоміше лігво.", false],
	],
	"galaxy": [
		[1, "", "Чотири квадранти, сто систем і п'ятсот планет і станцій. Кожен квадрант складніший за попередній: завдання там краще оплачуються, вороги міцніші, а крамниці продають потужніше спорядження.", false],
		[1, "", "Переліт у межах квадранта коштує кредитів залежно від відстані; перехід до сусіднього чи протилежного квадранта коштує додатково. Коли ви побуваєте в усіх місцях галактики, подорожі стануть безкоштовними.", false],
	],
	"progress/ranks": [
		[1, "Репутація", "Репутація рахує знищених вами ворогів. Кожен поріг із таблиці нижче підвищує ваше звання, показане на екрані «Status».", false],
		[1, "Рівень", "Ваш рівень зростає разом із грошима, заробленими на місіях і завданнях. Коли загальний заробіток перевищує в 1,6 раза суму на момент попереднього рівня, ви досягаєте наступного. На вищих рівнях вороги у ваших місіях міцніші.", false],
	],
	"progress/milestones": [
		[1, "", "Під час стикування станція вітає вас повідомленням, коли ваші кредити вперше долають чергову віху або ваше дослідження галактики сягає нової позначки. Повідомлення нижче взято із самої гри.", false],
		[1, "Багатство", "Багатство — це не просто число. Маючи понад 999 999 кредитів, ви можете торгувати на будь-якій планеті й станції: ангар відкривається навіть там, де немає торгівлі, і ви можете купувати, продавати вантаж і здобич та переоснащувати корабель.", false],
		[1, "Дослідження", "Кожне відвідане місце зараховується. Відвідавши всі п'ятсот, ви подорожуватимете безкоштовно.", false],
	],
	"progress/loyalty": [
		[1, "", "Ваша лояльність десь між терранцями й восками — це показує покажчик на екрані «Status». Кожна місія для клієнта-терранця зсуває її на крок до терранців, кожна місія для клієнта-воска — на крок до восків. Далі ніж на десять кроків у будь-який бік вона не відходить.", false],
		[1, "", "Якщо ви летите до терранського місця, коли ваша лояльність схиляється до восків, або до місця восків, коли вона схиляється до терранців, окрім вартості перельоту з вас вимагають хабар: 150 кредитів за кожен крок. Сплачений хабар зсуває лояльність на крок назад до середини.", false],
	],
	"mode/survival": [
		[1, "", "Виживання — окремий режим із власним пілотом і таблицею рекордів. Оберіть його в «Start Game». Ворожі кораблі все прибувають, кожне знищення приносить очки й ремонтує корпус, а колір рамки ворога показує його силу. За очки ви отримуєте звання з таблиці нижче.", false],
	],
	"mode/swarm": [
		[1, "", "Рій — режим, створений для цього ремейку; він міститься в «Start Game». Він починається з жменьки винищувачів і розростається в натовп, що змикається з усіх боків, із хвилями після п'ятої хвилини.", false],
		[1, "", "Кожне знищення заповнює шкалу рівня. На кожному рівні пропонуються три картки покращень: нова зброя, краща версія наявної, додатковий ствол, більша дальність чи швидкість снарядів, міцніший щит, ремонт за кожне знищення або інший корпус. Відмова від картки натомість ремонтує чверть корпусу.", false],
		[1, "", "Зброя, щити й корпуси взято з вашого файлу гри. Звання в таблиці рекордів Виживання відкриває наступний корпус для Рою.", false],
	],
	"guide/start": [
		[1, "", "Після імпорту файлу гри «Start Game» пропонує кампанію, вільне дослідження, Виживання та Рій. Кампанія починається на [[station/0]] з кораблем [[ship/0]] і 5000 кредитів.", false],
		[1, "Меню станції", "На станції «Info» описує місце, «Hangar» відкриває крамницю та ваш корабель, «Missions» показує дошку завдань, а «Map» дає змогу подорожувати. Під час кампанії дошка завдань і мапа закриті, а «Go on» запускає наступний брифінг. «Status» показує рівень, репутацію, час гри, знищених ворогів і лояльність, а в «Menu» є налаштування та збереження.", false],
		[1, "", "Не скрізь є ангар, відкритий для всіх: без торгівлі ангар відкривається лише під час кампанії або якщо у вас понад 999 999 кредитів.", false],
	],
	"guide/flight": [
		[1, "", "Маршрутні точки позначено жовтим, союзників — зеленим, ворогів — червоним. Об'єкти поза полем зору показано біля краю екрана. Залишкова сила ворога вказана під його позначкою.", false],
		[1, "", "Щит поглинає зіткнення й влучання та з часом відновлюється; коли він вичерпується, шкода йде по корпусу. Прискорення дає короткий ривок і потребує часу на перезарядку.", false],
		[1, "Керування", "На клавіатурі кермуйте мишею або стрілками, тягою — клавішами W і S, боковим зсувом — A і D. Стрільба — клацання або Пробіл, зміна зброї — Q, ракети — F, прискорення — Shift. R вмикає автопілот, T прискорює час на безпечних ділянках, E стикує зі станцією поблизу, Esc ставить паузу. Геймпад цілиться правим стиком і стріляє правим курком. Сенсорне керування має стик, важіль тяги та кнопки вогню, ракет, прискорення й навігації; подвійний дотик до кнопки вогню вмикає автовогонь.", false],
		[1, "Автопілот і час", "Автопілот летить до наступної маршрутної точки або до станції. Поки вам ніщо не загрожує, час може плинути швидше; вороги, пошкодження або прибуття до мети повертають його до звичайного ходу.", false],
	],
	"guide/weapons": [
		[1, "", "Кораблі мають кріплення для п'яти видів зброї: лазерів, плазмових гармат, фотонних гармат, ракет і термогармат. Кожне кріплення тримає одну зброю, і кожен корабель має власний набір кріплень. Генератор щита підходить до будь-якого корабля.", false],
		[1, "", "Лазери й плазмові гармати швидко стріляють на середній відстані. Фотонні гармати б'ють найдалі й найсильніше за постріл, але повільно перезаряджаються. Термогармати поливають частинками на близькій відстані з дуже високою швидкострільністю. Ракети запускають окремою кнопкою, без зміни зброї, і вони завдають важкої шкоди за довгої перезарядки.", false],
		[1, "", "Щити відрізняються ємністю та швидкістю відновлення. Найпотужнішу зброю продають лише з другого квадранта, а зброю восків — лише в крамницях восків.", false],
	],
	"guide/hangar": [
		[1, "", "Ангар має три розділи: «Ship» показує ваш корабель із встановленою зброєю та щитом, «Cargo» зберігає ваші товари й запасне спорядження, а «Shop» пропонує асортимент станції.", false],
		[1, "", "Куплене спорядження потрапляє до трюму; встановіть його звідти, якщо на кораблі є вільне кріплення. Спорядження й кораблі продаються назад за половину ціни.", false],
		[1, "", "Купуючи корабель, ви здаєте поточний у залік. Спорядження, що підходить новому кораблю, лишається встановленим, а решта переходить до трюму, поки там є місце.", false],
		[1, "", "Крамниці продають від одного до чотирьох видів зброї чи щитів і до трьох кораблів, обраних із того, що дозволяють квадрант і народ місця. Асортимент оновлюється, коли ви повертаєтеся, злітавши деінде. Під час кампанії кожен розділ має власний сталий асортимент.", false],
	],
	"guide/trade": [
		[1, "", "Товари дістаються з уламків знищених кораблів і після місії потрапляють до трюму. Продавайте їх у розділі вантажу в ангарі. Одні дорожчі там, де технології низькі, інші — де високі, ще інші коштують скрізь однаково; на сторінці кожного товару вказано його ціну на кожному технологічному рівні.", false],
		[1, "", "Власних товарів крамниці не мають. Те, що ви продали в крамниці, лишається в її асортименті, і там само це можна викупити за тією ж ціною.", false],
		[1, "", "Для торгівлі потрібен ангар: планети й станції без торгівлі відкривають свій лише пілотам, які мають понад 999 999 кредитів.", false],
	],
	"guide/travel": [
		[1, "", "Мапа показує галактику, її квадранти й системи. Оберіть місце й летіть туди за вказану вартість перельоту, плюс хабар, якщо ваша лояльність проти його народу. Ви прибуваєте вже пристикованими.", false],
		[1, "", "Вартість перельоту зростає з відстанню. Зміна квадранта додає 15 000 кредитів, а протилежний квадрант — 30 000. Мапа показує, яку частину галактики ви дослідили; коли відвідано всі місця, подорожі нічого не коштують.", false],
		[1, "", "Галактика відкривається, коли кампанію завершено або коли ви її пропускаєте.", false],
