		[2, "", "Влад Борзиков — командир космического флота терранцев и, по словам Максвелла, самый паршивый тип во всём флоте. Он даёт Максвеллу первую оплачиваемую работу: очистить космический коридор от обломков на время.", false],
		[7, "", "Он сбивает шпиона Корсара Локвуда после того, как тот сдался, и настаивает, что приказ был уничтожить корабль.", false],
		[12, "", "Он и есть предатель: главарь бандитов, который пользовался своим званием, чтобы покрывать нападения на транспорты, и поручил Локвуду украсть военные секреты, которые продал восскам.", false],
		[13, "", "Когда Кристина Хаммонд бросается за ним после атаки на его станцию, он сбивает её и уходит.", false],
		[14, "", "Флот находит его с остатками бандитов, и Максвелл убивает его в поединке.", false],
	],
	"character/3": [
		[3, "", "Болар Ноблун — суетливый клиент, которому срочно нужно на [[station/1]], чтобы спасти сделку; он хорошо платит пилоту, готовому провезти его через пространство воссков.", false],
		[4, "", "Он переживает засаду воссков и обещает рекомендовать Максвелла.", false],
	],
	"character/4": [
		[4, "", "Восск с этим лицом окликает Максвелла по пути на Фебос и требует сдаться во имя Империи воссков.", false],
		[11, "", "Нарток Брек — глава клана расы [[race/1]]. Он тайно связывается с Максвеллом, потому что один из его собственных командиров вступил в сговор с офицером терранцев и бандитами, и просит устроить предателю засаду в туманности Ярапу. Прежде чем что-либо сказать, он требует от Максвелла честного слова.", false],
		[12, "", "После засады он сообщает Максвеллу, что тот уже знаком с предателем-терранцем.", false],
	],
	"character/5": [
		[4, "", "Джону Вашингтону, которого друзья зовут Док, нужен эскорт для его корабля до [[station/2]]. Он предлагает 3000 кредитов и соглашается на 4500 при условии, что свидетелей не будет. Максвелл подозревает поставку оружия для бандитов.", false],
		[5, "", "Его груз доходит. Что это было, он оставляет при себе.", false],
	],
	"character/6": [
		[6, "", "Пилот из звена Кристины Хаммонд, который спрашивает по радио, бывал ли этот Максвелл вообще в бою, не замечая, что тот всё слышит.", false],
		[13, "", "То же звено остаётся охранять станцию бандитов, пока Кристина и Максвелл преследуют Влада.", false],
	],
	"character/7": [
		[6, "", "Брент Сноком — офицер безопасности космического флота. Он отправляет Максвелла за шпионом [[character/8]] с приказом не допустить, чтобы украденный корабль попал в руки врага.", false],
	],
	"character/8": [
		[6, "", "Корсар Локвуд — шпион, сбежавший на одном из секретных кораблей космического флота.", false],
		[7, "", "Загнанный в угол в астероидном поле, он сдаётся, но Влад Борзиков всё равно его сбивает.", false],
		[12, "", "Позже выясняется, что именно Влад поручил ему украсть военные секреты.", false],
	],
	"character/9": [
		[7, "", "Мккт Бккт возит грузы для банды Осминоподов, известной перевозкой краденого. Он уверяет, что всё на борту совершенно законно, и платит Максвеллу за то, чтобы тот довёл его корабли до [[station/4]].", false],
	],
	"character/10": [
		[9, "", "Фекнор из греев слышал о Максвелле и предлагает ему трудную работу: четыре корабля до [[station/5]] через территорию воссков, по 4000 кредитов за каждый дошедший корабль.", false],
	],
	"character/11": [
		[1, "", "Адмирал Смит из космического флота терранцев подарил Максвеллу корабль после отставки и поручил лейтенанту Хаммонд показать, как им пользоваться.", false],
		[10, "", "Он вызывает Максвелла, когда атакуют нивелианскую станцию. Разговор накаляется, когда Максвелл заводит речь о своих расценках и о том, сколько могли бы заплатить восски.", false],
		[13, "", "После гибели Кристины он выражает Максвеллу соболезнования и сообщает, где скрываются бандиты Влада.", false],
		[14, "", "Он позволяет Максвеллу в одиночку преследовать Влада, предлагает ему место во флоте и, получив отказ, дарит гиперпространственный двигатель.", false],
	],
	"character/12": [
		[11, "", "Ботом Крант командует нивелианской станцией, которую атакуют восски. Он просит Максвелла сосредоточиться на крейсерах и благодарит его, когда атака отбита.", false],
	],
	"race/0": [
		[1, "", "Люди, воюющие с расой [[race/1]] в четвёртом тысячелетии. Максвелл — терранец, и большинство клиентов кампании служат в космическом флоте терранцев. Землянам принадлежит больше планет и станций, чем любому другому народу.", false],
		[1, "", "Многие продающиеся корабли — терранские разработки: [[ship/0]], [[ship/6]] и её модификация [[ship/7]], а также канонерка [[ship/4]].", false],
	],
	"race/1": [
		[1, "", "Враги терранцев. Магазины воссков продают только собственный истребитель, [[ship/8]], и только они продают оружие воссков. Пилоту, работающему на терранцев, на станциях воссков приходится давать взятки, и наоборот.", false],
	],
	"race/2": [
		[1, "", "Один из народов галактики, у которого есть собственные планеты и станции.", false],
	],
	"race/3": [
		[1, "", "Один из народов галактики, у которого есть собственные планеты и станции.", false],
	],
	"race/4": [
		[1, "", "Их особые компоненты используются в оружии вроде [[equipment/23]], а тяжёлый бомбардировщик [[ship/3]] — их разработка.", false],
	],
	"race/5": [
		[1, "", "Корабли греев славятся невероятно тяжёлой бронёй. Разведчик [[ship/9]] происходит из их флота и лишь недавно был переделан для пилотов-гуманоидов, а ракета [[equipment/4]] собрана из компонентов греев. Фекнор из греев нанимает Максвелла для опасного конвоя.", false],
	],
	"race/6": [
		[1, "", "Союзники терранцев. Истребитель [[ship/1]] — нивелианская разработка, а лазер [[equipment/2]] основан на нивелианских оружейных технологиях. Нападение воссков на одну из их станций всерьёз втягивает Максвелла в войну.", false],
	],
	"race/7": [
		[1, "", "Один из народов галактики, у которого есть собственные планеты и станции.", false],
	],
	"race/8": [
		[1, "", "Один из народов галактики, у которого есть собственные планеты и станции.", false],
	],
	"race/9": [
		[1, "", "Бандиты — не народ, а образ жизни: пираты и контрабандисты, владеющие собственными планетами и станциями. Только их магазины продают [[ship/7]], а [[station/2]] — их самое известное логово.", false],
	],
	"galaxy": [
		[1, "", "Четыре квадранта, сто систем и пятьсот планет и станций. Каждый квадрант сложнее предыдущего: задания там лучше оплачиваются, враги крепче, а магазины продают более мощное снаряжение.", false],
		[1, "", "Перелёт внутри квадранта стоит кредитов в зависимости от расстояния; переход в соседний или противоположный квадрант стоит дополнительно. Когда вы побываете во всех местах галактики, путешествия станут бесплатными.", false],
	],
	"progress/ranks": [
		[1, "Репутация", "Репутация считает уничтоженных вами врагов. Каждый порог из таблицы ниже повышает ваше звание, которое показано на экране «Статус».", false],
		[1, "Уровень", "Ваш уровень растёт вместе с деньгами, заработанными на миссиях и заданиях. Когда общий заработок превышает в 1,6 раза сумму на момент прошлого уровня, вы достигаете следующего. На высоких уровнях враги в ваших миссиях становятся крепче.", false],
	],
	"progress/milestones": [
		[1, "", "При стыковке станция приветствует вас сообщением, когда ваши кредиты впервые преодолевают очередной рубеж или ваше исследование галактики достигает новой отметки. Сообщения ниже взяты из самой игры.", false],
		[1, "Богатство", "Богатство — это не просто число. Имея больше 999 999 кредитов, вы можете торговать на любой планете и станции: ангар открывается даже там, где нет торговли, и вы можете покупать, продавать груз и трофеи и переоснащать корабль.", false],
		[1, "Исследование", "Каждое посещённое место засчитывается. Посетив все пятьсот, вы сможете путешествовать бесплатно.", false],
	],
	"progress/loyalty": [
		[1, "", "Ваша лояльность находится где-то между терранцами и воссками — это показывает указатель на экране «Статус». Каждая миссия для клиента-терранца сдвигает её на шаг к терранцам, каждая миссия для клиента-восска — на шаг к восскам. Дальше десяти шагов в любую сторону она не уходит.", false],
		[1, "", "Если вы летите в место терранцев, когда ваша лояльность склоняется к восскам, или в место воссков, когда она склоняется к терранцам, помимо стоимости перелёта с вас требуют взятку: 150 кредитов за каждый шаг. Уплаченная взятка сдвигает лояльность на шаг обратно к середине.", false],
	],
	"mode/survival": [
		[1, "", "Выживание — отдельный режим со своим пилотом и таблицей рекордов. Выберите его в меню «Начать новую игру». Вражеские корабли всё прибывают, каждое уничтожение приносит очки и чинит корпус, а цвет рамки врага показывает его силу. По набранным очкам вы получаете звание из таблицы ниже.", false],
	],
	"mode/swarm": [
		[1, "", "Рой — режим, созданный для этого ремейка; он находится в меню «Начать новую игру». Он начинается с горстки истребителей и разрастается в толпу, смыкающуюся со всех сторон, с волнами после пятой минуты.", false],
		[1, "", "Каждое уничтожение заполняет шкалу уровня. На каждом уровне предлагаются три карты улучшений: новое оружие, улучшенная версия имеющегося, дополнительный ствол, большая дальность или скорость снарядов, более сильный щит, ремонт за каждое уничтожение или другой корпус. Отказ от карты вместо этого чинит четверть корпуса.", false],
		[1, "", "Оружие, щиты и корпуса взяты из вашего файла игры. Звание в таблице рекордов Выживания открывает следующий корпус для Роя.", false],
	],
	"guide/start": [
		[1, "", "После импорта файла игры меню «Начать новую игру» предлагает кампанию, свободное исследование, Выживание и Рой. Кампания начинается на [[station/0]] с кораблём [[ship/0]] и 5000 кредитов.", false],
		[1, "Меню станции", "На станции «Сведения» описывают место, «Ангар» открывает магазин и ваш корабль, «Задания» показывают доску заданий, а «Карта» позволяет путешествовать. Во время кампании доска заданий и карта закрыты, а «Дальше» запускает следующий брифинг. «Статус» показывает уровень, репутацию, время игры, уничтоженных врагов и лояльность, а в «Меню» находятся настройки и сохранение.", false],
		[1, "", "Не везде есть ангар, открытый для всех: без торговли ангар открывается только во время кампании или если у вас больше 999 999 кредитов.", false],
	],
	"guide/flight": [
		[1, "", "Путевые точки отмечены жёлтым, союзники — зелёным, враги — красным. Объекты вне поля зрения показаны у края экрана. Оставшаяся сила врага указана под его меткой.", false],
		[1, "", "Щит поглощает столкновения и попадания и со временем восстанавливается; когда он иссякает, урон идёт по корпусу. Ускорение даёт короткий рывок и требует времени на перезарядку.", false],
		[1, "Управление", "На клавиатуре управляйте мышью или стрелками, тягой — клавишами W и S, боковым смещением — A и D. Стрельба — щелчок или Пробел, смена оружия — Q, ракеты — F, ускорение — Shift. R включает автопилот, T ускоряет время на безопасных участках, E стыкует со станцией поблизости, Esc ставит паузу. Геймпад целится правым стиком и стреляет правым курком. Сенсорное управление включает стик, рычаг тяги и кнопки огня, ракет, ускорения и навигации; двойное касание кнопки огня включает автоогонь.", false],
		[1, "Автопилот и время", "Автопилот летит к следующей путевой точке или к станции. Пока вам ничто не угрожает, время может идти быстрее; враги, урон или прибытие к цели возвращают его к обычному ходу.", false],
	],
	"guide/weapons": [
		[1, "", "У кораблей есть крепления для пяти видов оружия: лазеров, плазменных пушек, фотонных пушек, ракет и термопушек. Каждое крепление держит одно оружие, и у каждого корабля свой набор креплений. Генератор щита подходит к любому кораблю.", false],
		[1, "", "Лазеры и плазменные пушки быстро стреляют на средней дистанции. Фотонные пушки бьют дальше и сильнее всех за выстрел, но медленно перезаряжаются. Термопушки поливают частицами на близкой дистанции с очень высокой скорострельностью. Ракеты запускаются отдельной кнопкой, без смены оружия, и наносят тяжёлый урон при долгой перезарядке.", false],
		[1, "", "Щиты различаются ёмкостью и скоростью восстановления. Самое мощное оружие продаётся только со второго квадранта, а оружие воссков — только в магазинах воссков.", false],
	],
	"guide/hangar": [
		[1, "", "В ангаре три раздела: «Корабль» показывает ваш корабль с установленным оружием и щитом, «Фрахт» хранит ваши товары и запасное снаряжение, а «Магазин» предлагает ассортимент станции.", false],
		[1, "", "Купленное снаряжение попадает в трюм; установите его оттуда, если на корабле есть свободное крепление. Снаряжение и корабли продаются обратно за половину цены.", false],
		[1, "", "Покупая корабль, вы сдаёте нынешний в зачёт. Снаряжение, подходящее новому кораблю, остаётся установленным, а остальное переходит в трюм, пока там есть место.", false],
		[1, "", "Магазины продают от одного до четырёх видов оружия или щитов и до трёх кораблей, выбранных из того, что позволяют квадрант и народ места. Ассортимент обновляется, когда вы возвращаетесь, слетав куда-то ещё. Во время кампании у каждой главы свой постоянный ассортимент.", false],
	],
	"guide/trade": [
		[1, "", "Товары достаются из обломков уничтоженных кораблей и после миссии попадают в трюм. Продавайте их в разделе фрахта в ангаре. Одни дороже там, где технологии низкие, другие — где высокие, третьи стоят везде одинаково; на странице каждого товара указана его цена на каждом технологическом уровне.", false],
		[1, "", "Собственных товаров у магазинов нет. То, что вы продали в магазине, остаётся в его ассортименте, и там же это можно выкупить по той же цене.", false],
		[1, "", "Для торговли нужен ангар: планеты и станции без торговли открывают свой только пилотам, у которых больше 999 999 кредитов.", false],
	],
	"guide/travel": [
		[1, "", "Карта показывает галактику, её квадранты и системы. Выберите место и летите туда за указанную стоимость перелёта, плюс взятка, если ваша лояльность против его народа. Вы прибываете уже пристыкованным.", false],
		[1, "", "Стоимость перелёта растёт с расстоянием. Смена квадранта добавляет 15 000 кредитов, а противоположный квадрант — 30 000. Карта показывает, какую часть галактики вы исследовали; когда посещены все места, путешествия ничего не стоят.", false],
		[1, "", "Галактика открывается, когда кампания завершена или когда вы её пропускаете.", false],
	],
	"guide/jobs": [
		[1, "", "Вне кампании доска заданий на каждой станции предлагает несколько заказов от клиентов разных народов. У каждого указаны сложность и награда; трудные задания оплачиваются лучше, как и задания в дальних квадрантах.", false],
		[1, "", "Время от времени тёмный делец предлагает работу, которая оплачивается на сорок процентов выше обычного. Выполненное задание приносит награду и сдвигает вашу лояльность к народу клиента.", false],
	],
	"guide/campaign": [
		[1, "", "Кампания — это цепочка из тринадцати миссий. Выполненная миссия приносит награду; проваленную можно повторить. После завершения гиперпространственный двигатель открывает галактику, и становятся доступны доска заданий и карта.", false],
		[1, "", "«Пропустить кампанию · Исследование» в стартовом меню или в меню станции сразу переводит в свободное исследование. Пропуск не даёт наград за завершение и оставляет пилота кампании в его собственном слоте.", false],
	],
	"guide/saves": [
		[1, "", "Игра автоматически сохраняется после каждой миссии и в контрольных точках. У кампании, исследования, Выживания и Роя отдельные сохранения. «Загрузить / восстановить» в меню паузы или «Загрузить» после поражения возвращает к последнему автосохранению, началу полёта или последней станции.", false],
		[1, "", "«Файлы игры» → «Перенос сохранений» переносит ваши сохранения на другое устройство, где импортирован тот же файл игры.", false],
	],
	"guide/tips": [
